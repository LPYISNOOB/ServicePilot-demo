# 默认 mock：无需 API Key，完整流程仍可运行。
SERVICEPILOT_MODEL_MODE=mock

# OpenAI 兼容模式示例（DeepSeek、通义、硅基流动等均可配置）
SERVICEPILOT_MODEL_NAME=your-model-name
SERVICEPILOT_API_KEY=
SERVICEPILOT_BASE_URL=
SERVICEPILOT_TEMPERATURE=0.1
SERVICEPILOT_HOST=127.0.0.1
SERVICEPILOT_PORT=8000
SERVICEPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVICEPILOT_DB_PATH=./data/servicepilot.db
SERVICEPILOT_CHECKPOINT_PATH=./data/checkpoints.db
SERVICEPILOT_CHECKPOINT_MODE=sqlite

# 可选 LangSmith 观测
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=servicepilot-local

# 仅当本机 Docker Hub 镜像代理失效时使用；微软 devcontainer 镜像较大
# NODE_IMAGE=mcr.microsoft.com/devcontainers/javascript-node:24-bookworm
# PYTHON_IMAGE=mcr.microsoft.com/devcontainers/python:1-3.13-bookworm
